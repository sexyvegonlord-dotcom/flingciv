--// Press 8 = Head moves toward feet
--// Press 8 again = Return to normal

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local character
local humanoid
local root
local neck

local active = false
local connection

local DURATION = 0.35

local function setupCharacter(char)
	character = char
	humanoid = char:WaitForChild("Humanoid")
	root = char:WaitForChild("HumanoidRootPart")

	local head = char:WaitForChild("Head")
	neck = head:FindFirstChild("Neck")

	if not neck then
		neck = char:FindFirstChild("Neck", true)
	end

	active = false
end

local function animateHead()
	if not neck or not root then
		return
	end

	if connection then
		connection:Disconnect()
	end

	local originalC0 = neck.C0

	-- Bend head forward/down toward feet
	local targetC0 =
		originalC0
		* CFrame.Angles(math.rad(-85), 0, 0)
		* CFrame.new(0, -1.5, 0)

	local startTime = tick()

	connection = RunService.RenderStepped:Connect(function()
		local alpha = math.clamp(
			(tick() - startTime) / DURATION,
			0,
			1
		)

		-- Smooth animation
		local smooth = alpha * alpha * (3 - 2 * alpha)

		if active then
			neck.C0 = originalC0:Lerp(targetC0, smooth)
		else
			neck.C0 = targetC0:Lerp(originalC0, smooth)
		end

		if alpha >= 1 then
			connection:Disconnect()
			connection = nil

			if not active then
				neck.C0 = originalC0
			end
		end
	end)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.Eight then
		active = not active
		animateHead()
	end
end)

player.CharacterAdded:Connect(function(char)
	if connection then
		connection:Disconnect()
		connection = nil
	end

	setupCharacter(char)
end)

if player.Character then
	setupCharacter(player.Character)
end
