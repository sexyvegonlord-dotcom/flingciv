--// 8 = Remove head BillboardGui + Remote Event GUI
--// K = Force respawn character

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer

local REMOTE_GUI_NAMES = {
	RemoteEventMonitor = true,
	RemoteEventsGui = true,
	RemoteEventGUI = true,
	RemoteMonitor = true,
	RemoteEventViewer = true
}

local function removeStuff()
	-- Remove BillboardGuis from your character's head
	local character = player.Character

	if character then
		local head = character:FindFirstChild("Head")

		if head then
			for _, object in ipairs(head:GetChildren()) do
				if object:IsA("BillboardGui") then
					object:Destroy()
				end
			end
		end

		-- Also check descendants of the character
		for _, object in ipairs(character:GetDescendants()) do
			if object:IsA("BillboardGui") then
				object:Destroy()
			end
		end
	end

	-- Remove Remote Event monitoring GUI from PlayerGui
	local playerGui = player:FindFirstChildOfClass("PlayerGui")

	if playerGui then
		for _, gui in ipairs(playerGui:GetChildren()) do
			if gui:IsA("ScreenGui") then
				if REMOTE_GUI_NAMES[gui.Name] then
					gui:Destroy()
				elseif string.find(string.lower(gui.Name), "remoteevent")
					or string.find(string.lower(gui.Name), "remote event")
					or string.find(string.lower(gui.Name), "remote monitor") then
					gui:Destroy()
				end
			end
		end
	end
end

local function forceSpawn()
	-- Request a fresh character
	pcall(function()
		player:LoadCharacter()
	end)
end

-- Keyboard controls
game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	-- 8 = delete GUI stuff
	if input.KeyCode == Enum.KeyCode.Eight then
		removeStuff()
	end

	-- K = force spawn
	if input.KeyCode == Enum.KeyCode.K then
		forceSpawn()
	end
end)

-- Clean the GUI again after respawn
player.CharacterAdded:Connect(function(character)
	task.wait(0.5)
	removeStuff()
end)
