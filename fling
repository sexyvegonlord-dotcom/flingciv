--// 8 = Head to Feet
--// 8 again = Restore normal head position

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local character
local head
local neck

local active = false
local renderConnection

local MOVE_TIME = 0.5
local DOWN_DISTANCE = 7

local function setup(char)
	character = char
	head = char:WaitForChild("Head")

	-- R15/R6 compatible neck search
	neck = head:FindFirstChild("Neck")

	if not neck then
		neck = char:FindFirstChild("Neck", true)
	end

	active = false
end

local function stopAnimation()
	if renderConnection then
		renderConnection:Disconnect()
		renderConnection = nil
	end
end

local function moveHead()
	if not neck then return end

	stopAnimation()

	local originalC0 = neck.C0

	-- Move the head downward while keeping the neck orientation
	local targetC0 =
		originalC0 * CFrame.new(0, -DOWN_DISTANCE, 0)

	local startTime = os.clock()

	renderConnection = RunService.RenderStepped:Connect(function()
		local alpha = math.clamp(
			(os.clock() - startTime) / MOVE_TIME,
			0,
			1
		)

		-- Smooth movement
		local smooth = alpha * alpha * (3 - 2 * alpha)

		if active then
			neck.C0 = originalC0:Lerp(targetC0, smooth)
		else
			neck.C0 = targetC0:Lerp(originalC0, smooth)
		end

		if alpha >= 1 then
			if not active then
				neck.C0 = originalC0
			end

			stopAnimation()
		end
	end)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end

	if input.KeyCode == Enum.KeyCode.Eight then
		active = not active
		moveHead()
	end
end)

player.CharacterAdded:Connect(function(char)
	stopAnimation()
	setup(char)
end)

if player.Character then
	setup(player.Character)
end
