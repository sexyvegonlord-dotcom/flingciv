-- HEAD TO FEET
-- LocalScript
-- Press 8 to toggle

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local ANIMATION_ID = "rbxassetid://91134423929961"

local track = nil
local enabled = false

local function getCharacter()
	return player.Character or player.CharacterAdded:Wait()
end

local function stopAnimation()
	if track then
		pcall(function()
			track:Stop(0.15)
			track:Destroy()
		end)
		track = nil
	end
end

local function startAnimation()
	local character = getCharacter()

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	local animator = humanoid:FindFirstChildOfClass("Animator")

	-- Use the Animator Roblox already created for the character.
	if not animator then
		warn("No Animator found in character.")
		return
	end

	stopAnimation()

	local animation = Instance.new("Animation")
	animation.AnimationId = ANIMATION_ID

	local success, result = pcall(function()
		return animator:LoadAnimation(animation)
	end)

	animation:Destroy()

	if not success then
		warn("Animation failed to load:", result)
		return
	end

	track = result

	track.Priority = Enum.AnimationPriority.Action4
	track.Looped = true

	track:Play(0.15, 1, 1)

	-- Keep it playing.
	task.spawn(function()
		while enabled and track == result do
			if not result.IsPlaying then
				pcall(function()
					result:Play(0.15, 1, 1)
				end)
			end
			task.wait(0.1)
		end
	end)
end

local function toggle()
	enabled = not enabled

	if enabled then
		startAnimation()
	else
		stopAnimation()
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode == Enum.KeyCode.Eight then
		toggle()
	end
end)

player.CharacterAdded:Connect(function()
	enabled = false
	track = nil
end)
